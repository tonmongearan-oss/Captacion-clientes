# Copia este archivo como ".env" (el lanzador lo hace solo la primera vez) y rellena lo que necesites.
# Las líneas que empiezan por # se ignoran. No pongas espacios alrededor del "=".

# Puerto local de la aplicación (http://localhost:4567)
PORT=4567

# --- Asistente IA (opcional) ---------------------------------------------
# Clave de la API de Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-opus-5-5 (máxima calidad). Más económico: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Places API (New) (opcional, de pago) -------------------------
# Añade más negocios, teléfonos y valoraciones. Ver README, apartado "Google Places".
GOOGLE_PLACES_API_KEY=

# --- OpenStreetMap (gratis, no necesita clave) ----------------------------
# Servidor Overpass principal (se prueban otros automáticamente si falla)
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Segundos máximos de espera a Overpass antes de seguir solo con Nominatim
OVERPASS_MAX_WAIT=130
